{
  "name": "media-suite",
  "private": true,
  "description": "MedIA Suite — triage hospitalario con IA (PWA)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.e2e.js",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-media-suite \"node --test tests-rules/\""
  },
