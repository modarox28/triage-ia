    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "axe-core": "^4.14.0",
    "chart.js": "4.5.1",
    "firebase": "^13.0.0",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "playwright": "^1.63.0",
    "qrcodejs": "1.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0",
    "dompurify": "^3.4.16"
  }
}
